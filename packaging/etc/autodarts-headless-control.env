# Autodarts Headless Control – Konfiguration
# Änderungen bleiben bei Paket-Updates erhalten. Danach:
#   sudo systemctl restart autodarts-headless-control

AUTODARTS_USER=autodarts
AUTODARTS_HOME=/var/lib/autodarts-headless-control
AUTODARTS_EXECUTABLE=
HEADLESS_HTTP_PORT=80
HEADLESS_WS_PORT=8092

# Automatischer Setup-Hotspot (optional)
# HEADLESS_HOTSPOT_FALLBACK=1
# HEADLESS_HOTSPOT_GRACE=45
# HEADLESS_HOTSPOT_RETRY=300

# Automatische Updates von Headless Control (täglich, 1 = an, 0 = aus)
HEADLESS_AUTO_UPDATE=1

# Autodarts automatisch als Hintergrunddienst einrichten (optional)
# HEADLESS_AUTODARTS_AUTOSTART=1
