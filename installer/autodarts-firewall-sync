#!/usr/bin/env bash
set -Eeuo pipefail

STATE_DIR="/var/lib/autodarts-headless-control-firewall"
STATE_FILE="$STATE_DIR/active-state"
LOCK_FILE="/run/autodarts-firewall-sync.lock"
ENV_FILE="/etc/autodarts-headless-control.env"

log() {
    logger -t autodarts-firewall-sync -- "$*"
}

# Serialisiert parallele Aufrufe (NetworkManager-Dispatcher, ifupdown-Hook).
# Nicht abbrechen, sondern warten: Ein früher Lauf kann das Netz noch ohne
# Adresse gesehen haben, erst der spätere sieht den fertigen Zustand.
exec 9>"$LOCK_FILE"
flock -w 60 9 || exit 0

[[ $EUID -eq 0 ]] || exit 1
# Ohne ufw (z. B. firewalld auf Fedora/openSUSE) gibt es nichts zu synchronisieren.
command -v ufw >/dev/null 2>&1 || exit 0
command -v ip >/dev/null 2>&1 || exit 1
command -v nmcli >/dev/null 2>&1 || exit 1

# Ports aus der Konfiguration (z. B. 8080, falls Port 80 belegt war)
read_port() {
    local value
    value="$(grep -E "^[[:space:]]*$1[[:space:]]*=" "$ENV_FILE" 2>/dev/null | tail -n1 | tr -cd '0-9')"
    printf '%s\n' "${value:-$2}"
}
UFW_DEFAULTS="/etc/default/ufw"

# Filtert ufw auch IPv6? Nur dann braucht es IPv6-Freigaben
# (mit IPV6=no lässt ufw IPv6 unangetastet).
ufw_ipv6() {
    grep -qiE '^[[:space:]]*IPV6[[:space:]]*=[[:space:]]*"?yes' "$UFW_DEFAULTS" 2>/dev/null
}

HTTP_PORT="$(read_port HEADLESS_HTTP_PORT 80)"
WS_PORT="$(read_port HEADLESS_WS_PORT 8092)"

mkdir -p "$STATE_DIR"
chmod 700 "$STATE_DIR"

# Entfernt nur Regeln, die anhand ihrer Autodarts-Kommentare
# eindeutig diesem Skript bzw. dem bisherigen Installer zugeordnet sind.
remove_managed_rules() {
    local -a numbers=()
    local line number

    while IFS= read -r line; do
        if [[ "$line" =~ ^\[[[:space:]]*([0-9]+)\] ]]; then
            number="${BASH_REMATCH[1]}"

            case "$line" in
                *"# Autodarts HTTP LAN"*|\
                *"# Autodarts WebSocket LAN"*|\
                *"# Autodarts Board-Manager LAN"*|\
                *"# Autodarts HTTP Hotspot"*|\
                *"# Autodarts WebSocket Hotspot"*|\
                *"# Autodarts Board-Manager Hotspot"*|\
                *"# Autodarts mDNS LAN"*|\
                *"# Autodarts mDNS Hotspot"*|\
                *"# Autodarts DNS Hotspot"*|\
                *"# Autodarts DHCP Hotspot"*|\
                *"# mDNS (Avahi)"*)
                    numbers+=("$number")
                    ;;
            esac
        fi
    done < <(LC_ALL=C ufw status numbered)

    # Rückwärts löschen, damit sich die übrigen Regelnummern
    # nicht auf die noch ausstehenden Löschvorgänge auswirken.
    for ((i=${#numbers[@]}-1; i>=0; i--)); do
        ufw --force delete "${numbers[$i]}" >/dev/null
    done
}

# Liefert das erste aktive Autodarts-Hotspot-Gerät, sofern es
# tatsächlich die erwartete Gateway-Adresse besitzt.
find_hotspot_interface() {
    local device type state connection addresses

    while IFS=: read -r device type state; do
        [[ "$type" == "wifi" && "$state" == "connected" ]] || continue

        connection="$(nmcli -g GENERAL.CONNECTION device show "$device" 2>/dev/null || true)"
        [[ "$connection" == autodarts-hotspot-* ]] || continue

        addresses="$(ip -o -4 addr show dev "$device" scope global 2>/dev/null || true)"
        if grep -qE 'inet 192\.168\.4\.1/24([[:space:]]|$)' <<<"$addresses"; then
            printf '%s\n' "$device"
            return 0
        fi
    done < <(nmcli -t -f DEVICE,TYPE,STATE device status 2>/dev/null)

    return 1
}

# Ermittelt das Subnetz einer regulären Ethernet- oder WLAN-Verbindung.
lan_entry() {
    local device="$1" type cidr subnet

    [[ -n "$device" ]] || return 1

    type="$(nmcli -g GENERAL.TYPE device show "$device" 2>/dev/null || true)"
    # Ohne Antwort von NetworkManager (z. B. beim Booten per ifupdown,
    # bevor NetworkManager läuft): Art des Anschlusses aus sysfs ableiten.
    if [[ -z "$type" && -e "/sys/class/net/$device/device" ]]; then
        if [[ -d "/sys/class/net/$device/wireless" ]]; then
            type="wifi"
        else
            type="ethernet"
        fi
    fi
    case "$type" in
        ethernet|wifi) ;;
        *) return 1 ;;
    esac

    cidr="$(
        ip -o -4 addr show dev "$device" scope global |
        awk '$4 !~ /^169\.254\./ {print $4; exit}'
    )"
    [[ -n "$cidr" ]] || return 1

    subnet="$(
        python3 -c 'import ipaddress,sys; print(ipaddress.ip_interface(sys.argv[1]).network)' "$cidr"
    )"

    # Keine pauschalen Freigaben für ungewöhnlich große Netze.
    # Solche Konfigurationen müssen ausdrücklich geprüft werden.
    python3 - "$subnet" <<'PY'
import ipaddress
import sys

network = ipaddress.ip_network(sys.argv[1], strict=False)
if network.version != 4 or network.prefixlen < 16:
    sys.exit(1)
PY

    printf '%s|%s\n' "$device" "$subnet"
}

# IPv6-Netze eines Anschlusses: die direkt erreichbaren Präfixe aus den
# Routen (vom Router per Router Advertisement verteilt, ändern sich beim
# Anbieter oft täglich) plus Link-Local. Ohne diese Freigaben liefen Geräte,
# die IPv6 bevorzugen, zuerst in die Sperre.
lan6_prefixes() {
    local device="$1"

    ip -6 route show dev "$device" 2>/dev/null |
    awk '$1 ~ /\// && $0 !~ / via / {print $1}' |
    python3 -c '
import ipaddress
import sys

seen = set()
for line in sys.stdin:
    try:
        net = ipaddress.ip_network(line.strip(), strict=False)
    except ValueError:
        continue
    # Nur übliche LAN-Präfixe (/48 bis /64), kein Link-Local/Multicast
    if net.version != 6 or not 48 <= net.prefixlen <= 64:
        continue
    if net.is_link_local or net.is_multicast:
        continue
    seen.add(net)
for net in sorted(seen):
    print(net)
'
    printf 'fe80::/10\n'
}

# Alle Anschlüsse mit Default-Route (z. B. Kabel und WLAN gleichzeitig),
# damit die Box über jede ihrer Adressen erreichbar bleibt.
find_lans() {
    local device
    while IFS= read -r device; do
        lan_entry "$device" || true
    done < <(
        ip -4 route show default |
        awk '{for (i = 1; i < NF; i++) if ($i == "dev") print $(i + 1)}' |
        awk '!seen[$0]++'
    )
}

# Passt /etc/avahi/avahi-daemon.conf gezielt an, sichert vor der ersten
# Änderung das Original und vermeidet blindes Überschreiben:
# - allow-interfaces: nur die aktuell freigegebenen Anschlüsse
# - IPv6-Adressen veröffentlichen (Standard von Avahi; v1.0.7 hatte das
#   abgeschaltet): Windows wartet sonst bei jeder Namensauflösung rund
#   drei Sekunden vergeblich auf eine IPv6-Antwort, und Seiten laden
#   verzögert oder gar nicht. Die Firewall gibt dafür das IPv6-Heimnetz frei.
sync_avahi_interface() {
    local target_iface="$1"
    local conf="/etc/avahi/avahi-daemon.conf"
    local orig="/etc/avahi/avahi-daemon.conf.orig"

    [[ -f "$conf" ]] || return 0

    if [[ ! -f "$orig" ]]; then
        cp -p "$conf" "$orig"
    fi

    local ret=0
    python3 - "$conf" "$target_iface" <<'PY' || ret=$?
import os
import sys
import tempfile

conf_path = sys.argv[1]
target_iface = sys.argv[2]

# Gewünschte Werte je Abschnitt
desired = {
    "server": {"allow-interfaces": target_iface, "use-ipv6": "yes"},
    "publish": {"publish-aaaa-on-ipv4": "yes"},
}

with open(conf_path, "r", encoding="utf-8") as f:
    lines = f.readlines()
if lines and not lines[-1].endswith("\n"):
    lines[-1] += "\n"

new_lines = []
section = None
done = {name: set() for name in desired}


def flush_missing(name):
    """Fehlende Schlüssel am Ende des Abschnitts ergänzen."""
    if name not in desired:
        return
    for key, value in desired[name].items():
        if key not in done[name]:
            new_lines.append(f"{key}={value}\n")
            done[name].add(key)


for line in lines:
    stripped = line.strip()
    if stripped.startswith("[") and stripped.endswith("]"):
        flush_missing(section)
        section = stripped[1:-1].strip().lower()
        new_lines.append(line)
        continue

    if section in desired:
        key = stripped.lstrip("#").split("=", 1)[0].strip()
        if "=" in stripped and key in desired[section]:
            if key in done[section]:
                # Doppelte Einträge entfernen (auskommentierte bleiben stehen)
                if stripped.startswith("#"):
                    new_lines.append(line)
                continue
            new_lines.append(f"{key}={desired[section][key]}\n")
            done[section].add(key)
            continue
    new_lines.append(line)

flush_missing(section)
for name in desired:
    if not done[name]:
        new_lines.append(f"\n[{name}]\n")
        flush_missing(name)

if new_lines != lines:
    dir_name = os.path.dirname(conf_path)
    with tempfile.NamedTemporaryFile("w", dir=dir_name, delete=False, encoding="utf-8") as tf:
        tf.writelines(new_lines)
        temp_name = tf.name
    st = os.stat(conf_path)
    os.chmod(temp_name, st.st_mode)
    os.chown(temp_name, st.st_uid, st.st_gid)
    os.replace(temp_name, conf_path)
    sys.exit(10)
sys.exit(0)
PY
    if [[ $ret -eq 10 ]]; then
        log "Avahi-Konfiguration aktualisiert: allow-interfaces=$target_iface, IPv4 und IPv6"
        if command -v systemctl >/dev/null 2>&1; then
            systemctl try-restart avahi-daemon >/dev/null 2>&1 || true
        fi
    fi
}

# Freizugebende Zugänge, je Eintrag "modus|gerät|subnetz".
entries=()
hotspot_iface=""
if hotspot_iface="$(find_hotspot_interface)"; then
    entries+=("hotspot|$hotspot_iface|192.168.4.0/24")
else
    hotspot_iface=""
fi
while IFS= read -r lan; do
    [[ -n "$lan" && "${lan%%|*}" != "$hotspot_iface" ]] || continue
    entries+=("lan|$lan")
    # IPv6 desselben Anschlusses (die Präfixe stehen im Zustand, ein
    # Präfixwechsel führt so beim nächsten Lauf zu neuen Regeln)
    if ufw_ipv6; then
        while IFS= read -r prefix; do
            [[ -n "$prefix" ]] && entries+=("lan|${lan%%|*}|$prefix")
        done < <(lan6_prefixes "${lan%%|*}")
    fi
done < <(find_lans)

# Regelsatz-Version im Zustand: Ändern sich die Regeln oder die Avahi-
# Einstellungen (z. B. neuer Port, v6: IPv6-Heimnetz freigeben), werden
# bestehende Installationen beim nächsten Lauf automatisch aktualisiert.
RULESET_VERSION="6"
if [[ ${#entries[@]} -gt 0 ]]; then
    entries_state="$(IFS=,; echo "${entries[*]}")"
else
    entries_state="none||"
fi
desired_state="$entries_state|v$RULESET_VERSION|$HTTP_PORT|$WS_PORT"
current_state="$(cat "$STATE_FILE" 2>/dev/null || true)"

# Unverändertes Netzwerk: keine unnötigen Regeländerungen.
if [[ "$desired_state" == "$current_state" ]]; then
    exit 0
fi

# Alte Autodarts-Regeln und die frühere globale mDNS-Freigabe
# entfernen, danach nur die aktuell gewünschten Zugänge freigeben.
remove_managed_rules

avahi_ifaces=()
for entry in "${entries[@]}"; do
    IFS='|' read -r mode interface subnet <<<"$entry"
    label="$([[ $mode == hotspot ]] && echo Hotspot || echo LAN)"

    ufw allow in on "$interface" from "$subnet" to any port "$HTTP_PORT" proto tcp \
        comment "Autodarts HTTP $label"

    ufw allow in on "$interface" from "$subnet" to any port "$WS_PORT" proto tcp \
        comment "Autodarts WebSocket $label"

    # Offizieller Autodarts Board-Manager (Weboberfläche ab Autodarts 2.1).
    ufw allow in on "$interface" from "$subnet" to any port 3180 proto tcp \
        comment "Autodarts Board-Manager $label"

    ufw allow in on "$interface" from "$subnet" to any port 5353 proto udp \
        comment "Autodarts mDNS $label"

    if [[ "$mode" == "hotspot" ]]; then
        ufw allow in on "$interface" to any port 53 \
            comment "Autodarts DNS Hotspot"
        ufw allow in on "$interface" to any port 67 proto udp \
            comment "Autodarts DHCP Hotspot"
    fi

    [[ " ${avahi_ifaces[*]} " == *" $interface "* ]] || avahi_ifaces+=("$interface")
    log "Aktiver Zugang: mode=$mode interface=$interface subnet=$subnet"
done

if [[ ${#avahi_ifaces[@]} -gt 0 ]]; then
    sync_avahi_interface "$(IFS=,; echo "${avahi_ifaces[*]}")"
else
    log "Kein geeignetes aktives LAN oder Autodarts-Hotspot gefunden; Autodarts-Zugriffsregeln entfernt."
fi

printf '%s\n' "$desired_state" > "$STATE_FILE"
chmod 600 "$STATE_FILE"
